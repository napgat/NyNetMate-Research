<mxfile host="app.diagrams.net" type="device"><diagram id="activity-network-discovery" name="3.3.3 การค้นหาอุปกรณ์และแสดงแผนผังเครือข่าย"><mxGraphModel dx="1510" dy="1940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1510" pageHeight="1940" math="0" shadow="0"><root>
