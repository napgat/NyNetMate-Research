@startuml
title Authentication and audit\nbackend audit-writer @ b862c60
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 18
skinparam titleFontSize 19
skinparam nodesep 24
skinparam ranksep 30
skinparam padding 8
skinparam componentBackgroundColor white
skinparam componentBorderColor #222222
skinparam noteBackgroundColor #FAFAFA
component "Authentication and audit" as Assembly {
 component "auth :\nAuthentication\nService" as Auth {
  portout " " as R_A01
  portout " " as R_A04
  portin " " as P_A07
 }
 component "bootstrap :\nUserProvisioning" as Bootstrap {
  portout " " as R_A02
  portout " " as R_A05
 }
 component "adapter :\nAuthAuditAdapter\nModule" as Adapter {
  portout " " as R_A03
  portin " " as P_A01
  portin " " as P_A02
 }
 component "writer :\nAuditAppendModule" as Writer {
  portin " " as P_A03
 }
 component "reader :\nAuditReadModule" as Reader {
  portout " " as R_A06
  portout " " as R_A07
 }
 component "database :\nDatabaseRuntime" as Database {
  portin " " as P_A04
  portin " " as P_A05
  portin " " as P_A06
 }
 R_A01 -(0- P_A01 : A01: \nIRecordAuthEvent
 R_A02 -(0- P_A02 : A02: \nIRecordAuthEvent
 R_A03 -(0- P_A03 : A03: \nAuditWriter
 R_A04 -(0- P_A04 : A04: \nIAsyncSession\nFactory
 R_A05 -(0- P_A05 : A05: \nIAsyncSession\nFactory
 R_A06 -(0- P_A06 : A06: \nIAsyncSession\nFactory
 R_A07 -(0- P_A07 : A07: \nIAuthorize
}
legend bottom left
 Socket = required; ball = provided.
 Square = port; contract IDs: CONTRACTS.md
endlegend
@enduml

