<mxCell id="display" value="แสดงแบบฟอร์ม&#xa;ค้นหาอุปกรณ์เครือข่าย" style="rounded=1;arcSize=18;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontFamily=Tahoma;fontSize=18;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="frontend"><mxGeometry x="30" y="125" width="260" height="64" as="geometry"/></mxCell>
<mxCell id="input" value="ระบุ IP อุปกรณ์เริ่มต้น&#xa;และโปรไฟล์ข้อมูล&#xa;สำหรับเชื่อมต่อ" style="rounded=1;arcSize=18;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontFamily=Tahoma;fontSize=18;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="user"><mxGeometry x="25" y="255" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="submit" value="กดเริ่มค้นหา" style="rounded=1;arcSize=18;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontFamily=Tahoma;fontSize=18;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="user"><mxGeometry x="35" y="395" width="180" height="64" as="geometry"/></mxCell>
<mxCell id="send" value="ส่งคำขอค้นหาอุปกรณ์&#xa;ไปยัง Backend" style="rounded=1;arcSize=18;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontFamily=Tahoma;fontSize=18;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="frontend"><mxGeometry x="30" y="395" width="260" height="64" as="geometry"/></mxCell>
<mxCell id="validate" value="ตรวจสอบข้อมูล โปรไฟล์เชื่อมต่อ&#xa;และขอบเขตการค้นหา" style="rounded=1;arcSize=18;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontFamily=Tahoma;fontSize=18;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="backend"><mxGeometry x="230" y="385" width="440" height="84" as="geometry"/></mxCell>
<mxCell id="valid" value="ข้อมูลถูกต้อง?" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontFamily=Tahoma;fontSize=18;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="backend"><mxGeometry x="330" y="520" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="collect" value="ค้นหาและรวบรวมข้อมูลผ่าน&#xa;Network Discovery Library และ SNMP&#xa;ภายในเครือข่ายทดสอบ&#xa;พร้อมเก็บข้อมูลที่รวบรวมสำเร็จ" style="rounded=1;arcSize=18;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontFamily=Tahoma;fontSize=18;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="backend"><mxGeometry x="270" y="685" width="360" height="125" as="geometry"/></mxCell>
<mxCell id="result" value="ผลการค้นหา" style="rhombus;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontFamily=Tahoma;fontSize=18;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="backend"><mxGeometry x="320" y="865" width="260" height="120" as="geometry"/></mxCell>
<mxCell id="succeeded" value="บันทึกผลค้นหาสำเร็จ&#xa;และข้อมูลความสัมพันธ์&#xa;ที่มีหลักฐานรองรับ" style="rounded=1;arcSize=18;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontFamily=Tahoma;fontSize=18;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="backend"><mxGeometry x="35" y="1050" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="partial" value="บันทึกผลค้นหาได้บางส่วน&#xa;พร้อมข้อจำกัดหรือ&#xa;ส่วนที่รวบรวมไม่ได้" style="rounded=1;arcSize=18;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontFamily=Tahoma;fontSize=18;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="backend"><mxGeometry x="330" y="1050" width="240" height="90" as="geometry"/></mxCell>
<mxCell id="failed" value="บันทึกผลค้นหาล้มเหลว&#xa;โดยไม่ลบข้อมูล&#xa;อุปกรณ์เดิม" style="rounded=1;arcSize=18;html=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontFamily=Tahoma;fontSize=18;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="backend"><mxGeometry x="625" y="1050" width="240" height="90" as="geometry"/></mxCell>
